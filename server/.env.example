# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://policydesk:policydesk@localhost:5432/policydesk
REDIS_URL=redis://localhost:6379
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# File storage: "local" for now (uploads/ folder). An S3-compatible adapter can be added once hosting is decided.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# --- Integrations (Milestone 3; leave blank until accounts exist) ---
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_MESSAGING_SERVICE_SID=
SENDGRID_API_KEY=
OPENAI_API_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=

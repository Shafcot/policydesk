# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://policydesk:policydesk@localhost:5432/policydesk
REDIS_URL=redis://localhost:6379
# Long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-me
JWT_EXPIRES_IN=12h
CLIENT_ORIGIN=http://localhost:5173

# File storage: "local" for now (uploads/ folder). An S3-compatible adapter can be added once hosting is decided.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Daily database backups (pg_dump must be installed). Leave empty to disable.
BACKUP_DIR=
BACKUP_KEEP=14
# Set to false to run the background worker as its own process (npm run worker -w server).
RUN_WORKER=true

# --- Integrations (see INTEGRATIONS.md) ---
# Usually entered in the app instead: Settings → Integrations (stored encrypted; wins over these).
# Encryption key for keys saved in the app (defaults to JWT_SECRET). Keep it stable.
SETTINGS_ENCRYPTION_KEY=
# Public HTTPS address of this API (webhooks + Twilio signature checks), e.g. https://crm.agency.com
PUBLIC_API_URL=
# Agency that receives Facebook / Google leads (leave empty for single-agency installs)
DEFAULT_AGENCY_ID=

# Twilio (calling, recording, SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_MESSAGING_SERVICE_SID=
# Default caller ID (E.164) when an agent has no number of their own
TWILIO_CALLER_ID=
# Optional sentence played to the lead when they answer, e.g. "This call may be recorded for quality."
CALL_RECORDING_NOTICE=

# SendGrid (email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=
SENDGRID_INBOUND_DOMAIN=
SENDGRID_INBOUND_KEY=

# OpenAI (transcripts, summaries, AI replies)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Firebase (push). Paste the service-account JSON on one line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# Facebook Lead Ads
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v21.0

# Google Ads lead form webhook key
GOOGLE_ADS_WEBHOOK_KEY=
